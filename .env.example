# Copy to `.env` and fill in. Every value here maps 1:1 to a field in
# shared_utils/config.py (field name, case-insensitive).

# --- API keys -----------------------------------------------------------------
# Needed from Step 1 (answering + escalated judge verdicts) onward.
OPENAI_API_KEY=
# Needed from Step 1 for the default cascade judge, and for the Jev reranker and router later.
TYPESAFE_API_KEY=

# --- Infrastructure -----------------------------------------------------------
QDRANT_URL=http://localhost:6333

# --- Models -------------------------------------------------------------------
# Cheap model for answering and query expansion; stronger model only for judging.
ANSWER_MODEL=gpt-5.6-luna
EXPANSION_MODEL=gpt-5.6-luna
JUDGE_MODEL=gpt-5.6-sol
EMBEDDING_MODEL=text-embedding-3-small
# Pinned Jev version (an alias like jev-latest can change under a warm cache).
JEV_MODEL=jev-1.13.0
# cascade = Jev first, uncertain verdicts to JUDGE_MODEL (~$1.20 / 500 questions)
# sol     = JUDGE_MODEL on everything (~$4 / 500)   jev = Jev only (~$0.03 / 500)
JUDGE_MODE=cascade
# Reasoning tokens are billed as output tokens; "low" keeps calls cheap. Leave
# empty if the chosen chat model is not a reasoning model. Both are cache-key parts.
ANSWER_REASONING_EFFORT=low
# DO NOT CHANGE for the rest of the series: every phase must be scored by the
# same judge, and changing this invalidates every cached verdict.
JUDGE_REASONING_EFFORT=low

# --- Pricing (USD per 1M tokens) ---------------------------------------------
# Used for dry-run estimates and per-run cost reports. Fill these in from the
# provider's pricing page for the models you chose above. Models not listed are
# still token-counted; their cost is just reported as unknown.
# Format: JSON object  {"model": {"input": <usd>, "output": <usd>}}
# Jev bills input tokens only; a pinned jev-x.y.z falls back to the jev-latest price.
MODEL_PRICES={"text-embedding-3-small": {"input": 0.02, "output": 0.0}, "jev-latest": {"input": 0.042, "output": 0.0}}

# --- Budgets ------------------------------------------------------------------
# Max concurrent in-flight API calls (keeps us under provider rate limits).
MAX_CONCURRENCY=8
